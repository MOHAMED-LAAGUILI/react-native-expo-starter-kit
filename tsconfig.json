{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Required by allowImportingTsExtensions. Also inherited from
    // expo/tsconfig.base, but stated here so the config stays valid if an
    // editor reads it while node_modules is being reinstalled.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "customConditions": [],
     "checkJs": true,
    "paths": {
      "@/*": [
        "./src/*"
        
      ],
      "@assets/*": [
        "./assets/*"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "script/*.ts",
    ".expo/types/**/*.ts",
    "*.d.ts",
    "**/*.d.ts",
    "src/types/*.d.ts",
    "expo-env.d.ts",
    "uniwind-types.d.ts",

  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "script",
    "__tests__",
    "jest.config.js",
    "coverage",
    "dist",
    "android",
    "ios",
  ]
}
