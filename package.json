{
  "name": "react-native-expo-starter-kit",
  "main": "expo-router/entry",
  "version": "6.0.1",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "react-native",
    "expo",
    "android",
    "ios",
    "mobile",
    "starter-kit",
    "template",
    "SDK"
  ],
  "author": "MOHAMED-LAAGUILI <mohamed.dev.2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MOHAMED-LAAGUILI/react-native-expo-starter-kit.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "pnpm:devPreinstall": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/guard-node-modules.ts --from-install",
    "prepare": "husky",
    "guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/guard-node-modules.ts",
    "install:safe": "pnpm run guard && pnpm install",
    "setup": "pnpm run install:safe && pnpm run env:create && pnpm run setup:check",
    "setup:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/check-setup.ts",
    "env:create": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/create-env-files.ts",
    "env:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/create-env-files.ts --dry-run",
    "skills": "npx --yes skills list",
    "skills:find": "npx --yes skills find",
    "skills:add": "npx --yes skills add --agent claude-code --copy",
    "skills:update": "npx --yes skills update --project --yes",
    "skills:init": "npx --yes skills init",
    "dev": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start -c",
    "dev:atlas": "cross-env EXPO_ATLAS=true EXPO_NO_DEPENDENCY_VALIDATION=1 expo start -c",
    "android": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start -c -a",
    "ios": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start -c -i",
    "web": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start -c -w",
    "android:dev": "cross-env EXPO_PUBLIC_APP_ENV=development pnpm run android",
    "android:prev": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run android",
    "android:prod": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run android",
    "ios:dev": "cross-env EXPO_PUBLIC_APP_ENV=development pnpm run ios",
    "ios:prev": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run ios",
    "ios:prod": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run ios",
    "ios:pods": "npx pod-install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --cache",
    "type:check": "tsc --noemit && tsc --noemit -p script && tsc --noemit -p __tests__",
    "test": "jest --watchman=false",
    "test:node": "jest --watchman=false --selectProjects node",
    "test:rn": "jest --watchman=false --selectProjects rn",
    "test:watch": "jest --watch",
    "test:coverage": "jest --watchman=false --coverage",
    "test:discovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/check-jest-discovery.ts",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/check-locale-parity.ts",
    "docs:badges": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/sync-readme-badges.ts",
    "docs:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/sync-readme-badges.ts --check",
    "doctor": "npx expo-doctor@latest --verbose && npx react-doctor@latest --verbose",
    "checks": "pnpm run deps:fix && pnpm run lint:fix && pnpm run type:check && pnpm run test && pnpm run i18n:check && pnpm run docs:check && pnpm run doctor",
    "e2e:metro": "cross-env CI=1 EXPO_NO_METRO_LAZY=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --dev-client",
    "e2e:android": "maestro test --platform android -e APP_ID=com.rntemplate.app .maestro",
    "e2e:ios": "maestro test --platform ios -e APP_ID=com.rntemplate.app --exclude-tags android-only .maestro",
    "demo:record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/record-demo.ts",
    "deps:fix": "pnpm run guard && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/fix-deps.ts",
    "deps:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/check-deps.ts",
    "deps:unused": "knip --include dependencies,unlisted,binaries,files",
    "unreferenced": "node script/check-unreferenced-modules.js",
    "upgrade:expo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/upgrade-expo.ts",
    "perf:bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/bundle-report.ts",
    "perf:budget": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/bundle-report.ts --budget",
    "images:optimize": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/optimize-images.ts",
    "images:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/optimize-images.ts --check",
    "lottie:optimize": "node script/optimize-lottie.mjs",
    "expo:config": "expo config --type public",
    "prebuild": "expo prebuild --platform all",
    "prebuild:dev": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 expo prebuild --platform all",
    "prebuild:prev": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 expo prebuild --platform all",
    "prebuild:prod": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 expo prebuild --platform all",
    "build:local:android": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/build-local-android.ts",
    "build:local:install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/build-local-android.ts --install",
    "docker:build": "docker compose run --rm android-build",
    "docker:emulator": "docker compose up -d emulator && docker compose run --rm installer",
    "docker:down": "docker compose down",
    "eas:in": "npx eas-cli@latest login",
    "eas:id": "npx eas-cli@latest whoami",
    "eas:out": "npx eas-cli@latest logout",
    "build:dev:android": "npx eas-cli@latest build --profile development --platform android --clear-cache",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios --clear-cache",
    "build:prev:android": "npx eas-cli@latest build --profile preview --platform android --clear-cache",
    "build:prev:ios": "npx eas-cli@latest build --profile preview --platform ios --clear-cache",
    "build:prod:android": "npx eas-cli@latest build --profile production --platform android --clear-cache",
    "build:prod:ios": "npx eas-cli@latest build --profile production --platform ios --clear-cache",
    "flow:build-android:main": "npx eas-cli@latest workflow:run create-build-android-main.yml",
    "flow:build-ios:main": "npx eas-cli@latest workflow:run create-build-ios-main.yml",
    "submit:android": "npx eas-cli@latest submit --platform android",
    "submit:ios": "npx eas-cli@latest submit --platform ios",
    "eas:update:config": "npx eas-cli@latest update:configure",
    "eas:update:prev": "npx eas-cli@latest update --channel preview --environment preview --auto",
    "eas:update:prod": "npx eas-cli@latest update --channel production --environment production --auto",
    "export:web": "expo export --platform web",
    "deploy:web": "npx eas-cli@latest deploy --prod",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "clean:cache": "rimraf .expo",
    "clean:app": "pnpm run clean:cache && rimraf node_modules android ios build dist",
    "clean:all": "pnpm run clean:app && rimraf pnpm-lock.yaml"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@gorhom/bottom-sheet": "^5",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/menubar": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/toggle": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "@tanstack/react-form": "^1",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-devtools": "^5",
    "axios": "^1.18.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "expo": "~58.1.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.23",
    "expo-media-library": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.23",
    "expo-video": "~58.0.14",
    "i18next": "^26.3.4",
    "lucide": "^1.31.0",
    "lucide-react-native": "^1.21.0",
    "morphicons": "^1.7.0",
    "number-flow-react-native": "^0.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message-ts": "^1.0.7",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "reanimated-color-picker": "^5.1.2",
    "tailwindcss": "^4.2.1",
    "uniwind": "^1.14.0",
    "zod": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@babel/core": "^7.26.0",
    "@eslint-react/eslint-plugin": "^5.13.2",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "~19.3.3",
    "babel-jest": "^30.5.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "expo-atlas": "^0.4.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "knip": "^6.48.0",
    "react-doctor": "^0.7.8",
    "release-it": "^21.1.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "enabled": true,
        "exclude": []
      }
    },
    "install": {
      "exclude": []
    }
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ]
}
