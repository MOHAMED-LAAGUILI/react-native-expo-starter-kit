# EAS Build upload filter.
#
# When this file exists EAS CLI uses it INSTEAD of every .gitignore
# (https://docs.expo.dev/build-reference/project-upload/), so:
#   1. every .gitignore pattern is repeated below (section "Mirrored from
#      .gitignore" — guarded by __tests__/architecture/easignore.test.ts), and
#   2. everything else the build doesn't need is listed explicitly — a smaller
#      archive uploads faster and leaks nothing.
#
# The build needs: app/, src/, assets/, package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml, .npmrc, app.config.ts, eas.json, babel.config.js,
# metro.config.js, tsconfig.json, .eas/ and
# script/guard-node-modules.ts (run by the `pnpm:devPreinstall` hook).
#
# Check what actually uploads, without building:
#   npx eas-cli@latest build:inspect --platform android --stage archive --output ./eas-archive

# ── Mirrored from .gitignore (keep in sync, verbatim) ───────────────────────
node_modules/
.expo/
.metro-cache/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
yarn-error.log
/coverage
/android
/ios
maestro-out/
.DS_Store
.idea
.freebuff/
.kilo/
.env.production
.env.development
.env.preview
.eslintcache
expo-env.d.ts
skills-lock.json

# ── Dependencies & generated output ─────────────────────────────────────────
node_modules/
.expo/
.metro-cache/
dist/
build/
web-build/
/android
/ios
.kotlin/
*.tsbuildinfo
.eslintcache
npm-debug.*
*.log
*.orig.*

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli
expo-env.d.ts
# @end expo-cli

# ── Secrets & per-machine env ───────────────────────────────────────────────
# Cloud builds take EXPO_PUBLIC_* from the eas.json profile `env` and EAS
# environment variables (`eas env:create`), never from a developer's .env files.
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# ── Build artifacts ──────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa

# ── Tests & E2E ─────────────────────────────────────────────────────────────
__tests__/
.maestro/
jest.config.js
coverage/
maestro-out/

# ── Docs ────────────────────────────────────────────────────────────────────
/docs
/*.md

# ── Repo tooling (lint, hooks, CI, editors, agents) ─────────────────────────
.github/
.husky/
.vscode/
.idea
.editorconfig
.gitattributes
.gitleaks.toml
.cursorrules
compose.yaml
docker/
.mcp.json
.release-it.json
knip.json
perf-budget.json
eslint.config.mjs
components.json
/script/*
!/script/guard-node-modules.ts
.agents/
.claude
.freebuff
.freebuff/
.kilo/

# macOS
.DS_Store
